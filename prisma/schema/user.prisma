model User {
    id   String @id @default(uuid())
    name String  @db.VarChar(255)
    email String @unique
    password String
    activeStatus ActiveStatus @default(ACTIVE)

    user Role @default(USER)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    profile Profile?

    @@map("users")

}


enum ActiveStatus{
    ACTIVE
    BLOCKED
}

enum Role{
    USER 
    ADMIN
    AUTHOR
}
